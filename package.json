{
  "name": "otklikator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply otklikator --local",
    "db:migrate:remote": "wrangler d1 migrations apply otklikator --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:cf": "wrangler d1 migrations apply otklikator --remote && wrangler deploy",
    "deploy:prod": "wrangler d1 migrations apply otklikator-prod --remote --env production && wrangler deploy --env production"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.13.22",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.168.0"
  }
}
